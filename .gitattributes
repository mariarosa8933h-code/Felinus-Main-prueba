# Normaliza finales de línea en todos los archivos de texto
* text=auto

# Archivos de código y texto: siempre LF en el repositorio
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf

# Archivos de configuración
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf

# Archivos binarios (no se modifican)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.exe binary
*.dll binary
